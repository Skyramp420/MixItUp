{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixItUp",
  "version": "0.2.0",
  "identifier": "com.wherestheapp.mixitup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MixItUp",
        "width": 1000,
        "height": 700,
        "minWidth": 840,
        "minHeight": 580,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#252527",
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}